{
  "lang": "cpp",
  "display": "C++",
  "version": "1.0.0",
  "protocol": 1,
  "schema_version": 14,
  "rules": "cpp.yaml",
  "in_process": true,
  "reader": "extractors/cpp",
  "receiver_words": ["this"],
  "supplies_edges": false,
  "reports_literals": true,
  "discovery": {
    "suffixes": [
      ".cpp", ".cc", ".cxx", ".c++",
      ".hpp", ".hh", ".hxx", ".h++",
      ".h", ".inl", ".ipp"
    ],
    "skip_dirs": [
      "ThirdParty",
      "Intermediate",
      "Binaries",
      "DerivedDataCache",
      "Saved",
      "vcpkg_installed",
      "cmake-build-debug",
      "cmake-build-release",
      "CMakeFiles",
      "_deps"
    ],
    "skip_names": [],
    "test_dirs": ["Tests", "tests", "test", "gtest", "googletest"],
    "test_name_suffixes": [],
    "test_stem_prefixes": [],
    "test_stem_suffixes": ["Test", "Tests", "_test", "_tests", ".test", ".spec"],
    "test_stem_exact": []
  },
  "fingerprint": ["plugin.json"]
}
