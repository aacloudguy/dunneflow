{
  "lang": "rust",
  "display": "Rust",
  "version": "0.1.0",
  "protocol": 1,
  "schema_version": 20,
  "rules": "rust.yaml",
  "in_process": false,
  "workers": 1,
  "toolchain": {
    "command": "cargo",
    "probe": [
      "--version"
    ],
    "min_version": "1.79.0",
    "install": "rustup, from rustup.rs"
  },
  "build": [
    "cargo",
    "build",
    "--release",
    "--offline",
    "--locked",
    "--quiet",
    "--target-dir",
    "{workdir}"
  ],
  "product": "release/dunneflow-rust-reader",
  "build_env": {
    "RUSTFLAGS": null,
    "CARGO_BUILD_TARGET": null,
    "CARGO_TARGET_DIR": null,
    "CARGO_ENCODED_RUSTFLAGS": null
  },
  "receiver_words": [
    "self"
  ],
  "supplies_edges": true,
  "reports_literals": true,
  "discovery": {
    "suffixes": [
      ".rs"
    ],
    "skip_dirs": [
      "target",
      "vendor"
    ],
    "skip_names": [],
    "test_dirs": [
      "tests",
      "benches"
    ],
    "test_name_suffixes": [],
    "test_stem_prefixes": [],
    "test_stem_suffixes": [],
    "test_stem_exact": []
  },
