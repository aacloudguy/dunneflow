{
  "name": "@dunneflow/typescript-reader",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "DunneFlow's TypeScript reader: one FileFacts per file, over NDJSON on stdin and stdout.",
  "scripts": {
    "build": "node build.mjs",
    "typecheck": "tsc --noEmit",
    "schema": "cd ../../../.. && uv run python tools/gen_facts_ts.py --write"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "esbuild": "^0.25.0",
    "typescript": "5.9.3"
  }
}
