{
  "lang": "python",
  "display": "Python (out of process)",
  "version": "1.0.0",
  "protocol": 1,
  "schema_version": 16,
  "rules": "python.yaml",
  "in_process": false,
  "entry": "worker.py",
  "workers": 1,
  "toolchain": {
    "command": "python",
    "probe": ["--version"],
    "min_version": "",
    "install": "this interpreter — see ingest.outofprocess.SELF"
  },
  "receiver_words": ["self", "cls"],
  "supplies_edges": false,
  "reports_literals": true,
  "discovery": {
    "suffixes": [".py"],
    "skip_dirs": ["__pycache__"],
    "test_dirs": ["tests", "test", "testing"],
    "test_stem_prefixes": ["test_"],
    "test_stem_suffixes": ["_test"],
    "test_stem_exact": ["conftest"]
  },
  "fingerprint": ["plugin.json", "worker.py"]
}
